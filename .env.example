# Copy to .env. start.ps1 does this and fills in LANGFLOW_API_KEY for you.

# Where the LLM Configurator (coworkAI, read-only) listens. The blocks and the hand-off service read this.
LLM_CONFIGURATOR_URL=http://127.0.0.1:8001
# How many times a block retries after the configurator answers 429 (requests-per-minute limit).
LLM_CONFIGURATOR_429_RETRIES=3

# Langflow
LANGFLOW_URL=http://127.0.0.1:7860
# Created by scripts/create_langflow_key.py. Used by the hand-off service and stored (encrypted) in the evaluator.
LANGFLOW_API_KEY=

# Agent Evaluator
EVALUATOR_API_URL=http://127.0.0.1:8002/api
EVALUATOR_UI_URL=http://127.0.0.1:5174
